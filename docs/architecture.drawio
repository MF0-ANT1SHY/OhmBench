<mxCell id="n66" value="Contributor workflow: adding a case (docs/case-standard.md)" style="rounded=1;html=0;arcSize=8;fillColor=#eeeeee;strokeColor=#666666;fontSize=14;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="1404" height="32" as="geometry"/></mxCell>
<mxCell id="n67" value="1. Pick a real perf bug&#xa;in a public HarmonyOS app;&#xa;pin the upstream commit" style="rounded=1;html=0;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="34" y="765" width="172" height="72" as="geometry"/></mxCell>
<mxCell id="n68" value="2. Write source.patch&#xa;(base -&gt; unfixed) and&#xa;fix.patch (repair only)" style="rounded=1;html=0;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="224" y="765" width="172" height="72" as="geometry"/></mxCell>
<mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n67" target="n68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n70" value="3. Write testcase/:&#xa;same UI workload and&#xa;input data for both variants" style="rounded=1;html=0;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="414" y="765" width="172" height="72" as="geometry"/></mxCell>
<mxCell id="n71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n68" target="n70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n72" value="4. prepare_sources.py +&#xa;build_cases.py: trees&#xa;match, audit passes" style="rounded=1;html=0;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="604" y="765" width="172" height="72" as="geometry"/></mxCell>
<mxCell id="n73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n70" target="n72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n74" value="5. Sign, install, measure&#xa;unfixed vs fixed on a phone,&#xa;&gt;= 3 paired rounds" style="rounded=1;html=0;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="794" y="765" width="172" height="72" as="geometry"/></mxCell>
