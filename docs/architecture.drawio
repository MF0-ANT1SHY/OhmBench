<mxCell id="n14" value="Public upstream app repositories&#xa;(9 open-source HarmonyOS ArkTS apps,&#xa;pinned base commit)" style="rounded=1;html=0;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="32" y="130" width="236" height="62" as="geometry"/></mxCell>
<mxCell id="n15" value="cases/&lt;case-id&gt;/&#xa;- case.json: metadata, quality,&#xa;   runnability, hapray scene&#xa;- prompt.json: symptom only&#xa;- groundtruth.json: root causes, oracle&#xa;- source.patch: upstream -&gt; unfixed&#xa;- fix.patch: unfixed -&gt; fixed (repair only)&#xa;- testcase/: HapRay testcase, UI workload" style="rounded=1;html=0;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="32" y="210" width="236" height="178" as="geometry"/></mxCell>
