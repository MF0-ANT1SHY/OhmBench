+  /**
+   * 按关键词在 SQLite 中过滤歌曲，避免全表物化后在内存中过滤
+   * @param keyword 搜索关键词
+   * @returns LocalSong[]
+   */
+  async getSongsByKeyword(keyword: string): Promise<LocalSong[]> {
+    const columns = ['id', 'songId', 'name', 'artists', 'picFile', 'songFile', 'lyricFile']
+    // 转义 LIKE 通配符，保证关键词按字面匹配
+    const escaped = keyword.replace(/[\\%_]/g, (ch: string) => '\\' + ch)
+    const predicates = new relationalStore.RdbPredicates(TABLE_SONGS)
+      .like('songFile', `%${escaped}%`)
+
+    try {
+      const resultSet = await this.store.query(predicates, columns)
+      return await this.parseResultSet(resultSet)
+    } catch (e) {
+      LogUtil.error(TAG, 'Failed to get songs by keyword: ' + e.message)
+      return []
+    }
+  }
