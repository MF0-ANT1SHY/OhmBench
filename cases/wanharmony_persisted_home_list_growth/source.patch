+
+  // 对文章列表统一做一次 HTML 实体解码，避免列表项每次构建时重复解码
+  static decodeArticleList(datas: Array<DataX>): Array<DataX> {
+    datas.forEach((item: DataX) => {
+      item.title = TextUtils.htmlDecode(item.title)
+      if (item.desc) {
+        item.desc = TextUtils.htmlDecode(item.desc)
+      }
+      item.chapterName = TextUtils.htmlDecode(item.chapterName)
+    })
+    return datas
+  }
+}
