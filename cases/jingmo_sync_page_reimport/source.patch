+  static normalizeDatasetBaseUrl(value: string): string {
+    const address: string = value.trim();
+    if (address.length === 0) {
+      return NetworkConst.BASE_URL1;
+    }
+    if (!/^https?:\/\/[^\s/?#]+(?:\/[^\s?#]*)?$/.test(address)) {
+      throw new Error('请输入有效的 HTTP 或 HTTPS 地址');
+    }
+    return address.endsWith('/') ? address : address.concat('/');
+  }
+
+  static getDatasetBaseUrl(): string {
+    try {
+      const store: preferences.Preferences = preferences.getPreferencesSync(getContext(), { name: 'datasetSource' });
+      const address: string = store.getSync('baseUrl', NetworkConst.BASE_URL1) as string;
+      return NetworkConst.normalizeDatasetBaseUrl(address);
+    } catch {
+      return NetworkConst.BASE_URL1;
+    }
+  }
+
+  static async saveDatasetBaseUrl(value: string): Promise<void> {
+    const address: string = NetworkConst.normalizeDatasetBaseUrl(value);
+    const store: preferences.Preferences = preferences.getPreferencesSync(getContext(), { name: 'datasetSource' });
+    await store.put('baseUrl', address);
+    await store.flush();
+  }
+
   static readonly DATASET: string = "dataset_v2";
