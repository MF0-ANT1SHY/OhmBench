{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OhmBench diagnosis prediction",
  "type": "object",
  "required": ["suspects"],
  "properties": {
    "case": {"type": "string"},
    "tool": {"type": "string"},
    "suspects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "file": {"type": "string", "description": "source path within the app, or an ABC record name"},
          "class": {"type": ["string", "null"]},
          "symbol": {"type": ["string", "null"], "description": "function, method, field or constant"},
          "line_start": {"type": ["integer", "null"]},
          "line_end": {"type": ["integer", "null"]},
          "description": {"type": "string"}
        }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer"},
        "output_tokens": {"type": "integer"},
        "total_tokens": {"type": "integer"}
      }
    }
  }
}